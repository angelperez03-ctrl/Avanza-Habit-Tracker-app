<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:minHeight="120dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <!-- ENTIRE HABIT CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <!-- TOP ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- HABIT INFORMATION -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtHabitName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Morning run" />

                <TextView
                    android:id="@+id/txtHabitDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="#555555"
                    android:textSize="11sp"
                    tools:text="30 min jog before breakfast" />

            </LinearLayout>

            <!-- EDIT BUTTON -->
            <ImageButton
                android:id="@+id/btnEditHabit"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/edit_button_background"
                android:contentDescription="Edit habit"
                android:padding="6dp"
                android:src="@drawable/ic_edit"
                app:tint="#333333" />

            <!-- COMPLETION CIRCLE -->
            <View
                android:id="@+id/btnHabitComplete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/circle_incomplete"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- STREAK / FREQUENCY -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <TextView
            android:id="@+id/txtHabitStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Streak: " />

        <TextView
            android:id="@+id/txtFrequency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/frequency_background"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="Every day"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="11sp"/>

        </LinearLayout>

        <!-- DAYS OF WEEK -->
        <LinearLayout
            android:id="@+id/weekDaysLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- MONDAY -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:id="@+id/barMonday"
                    android:layout_width="32dp"
                    android:layout_height="6dp"
                    android:background="@drawable/day_bar_complete" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="M"
                    android:textColor="@color/black"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- TUESDAY -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:id="@+id/barTuesday"
                    android:layout_width="32dp"
                    android:layout_height="6dp"
                    android:background="@drawable/day_bar_complete" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="T"
                    android:textColor="@color/black"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- WEDNESDAY -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:id="@+id/barWednesday"
                    android:layout_width="32dp"
                    android:layout_height="6dp"
                    android:background="@drawable/day_bar_complete" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="W"
                    android:textColor="@color/black"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- THURSDAY -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:id="@+id/barThursday"
                    android:layout_width="32dp"
                    android:layout_height="6dp"
                    android:background="@drawable/day_bar_complete" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="T"
                    android:textColor="@color/black"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- FRIDAY -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:id="@+id/barFriday"
                    android:layout_width="32dp"
                    android:layout_height="6dp"
                    android:background="@drawable/day_bar_complete" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="F"
                    android:textColor="@color/black"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- SATURDAY -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:id="@+id/barSaturday"
                    android:layout_width="32dp"
                    android:layout_height="6dp"
                    android:background="@drawable/day_bar_complete" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="S"
                    android:textColor="@color/black"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- SUNDAY -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:id="@+id/barSunday"
                    android:layout_width="32dp"
                    android:layout_height="6dp"
                    android:background="@drawable/day_bar_incomplete" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="S"
                    android:textColor="@color/black"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>