<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dashboard_background">

    <!-- White form/card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/editHabitCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="70dp"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp">

            <!-- Drag handle -->
            <View
                android:id="@+id/drag_handle"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_marginTop="0dp"
                android:background="@drawable/drag_handle_shape"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Edit habit title -->
            <TextView
                android:id="@+id/editHabitTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Edit Habit"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/drag_handle"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/editHabitLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/habit_name"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/deleteWarningCard"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- Delete Habit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteHabit"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:text="Delete"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="@android:color/holo_red_dark"
                app:backgroundTint="@color/avanza_light_grey"
                app:cornerRadius="20dp"
                app:layout_constraintTop_toTopOf="@id/editHabitTitle"
                app:layout_constraintBottom_toBottomOf="@id/editHabitTitle"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Delete Warning Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/deleteWarningCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"

                app:cardBackgroundColor="#F3F3F3"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#FF2D36"
                app:strokeWidth="3dp"

                app:layout_constraintTop_toBottomOf="@id/editHabitTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <!-- Warning message -->
                    <TextView
                        android:id="@+id/txtDeleteWarning"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Delete Morning run? This can't be undone."
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        android:textStyle="bold"

                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Cancel Delete -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelDelete"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginEnd="8dp"

                        android:text="Cancel"
                        android:textAllCaps="false"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold"

                        app:backgroundTint="#A7A7AB"
                        app:cornerRadius="14dp"

                        app:layout_constraintTop_toBottomOf="@id/txtDeleteWarning"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnConfirmDelete"
                        app:layout_constraintWidth_percent="0.48" />

                    <!-- Confirm Delete -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConfirmDelete"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginStart="6dp"

                        android:text="Delete"
                        android:textAllCaps="false"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold"

                        app:backgroundTint="#FF2D36"
                        app:cornerRadius="14dp"

                        app:layout_constraintTop_toBottomOf="@id/txtDeleteWarning"
                        app:layout_constraintStart_toEndOf="@id/btnCancelDelete"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintWidth_percent="0.48" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Edit Habit Name text input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/editHabitNameInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="#D9D9D9"
                app:boxBackgroundMode="filled"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:hintEnabled="false"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:layout_constraintTop_toBottomOf="@id/editHabitLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editHabitNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="@string/e_g_journal_daily"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/black"
                    android:textColorHint="#777777"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/editHabitDescriptionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/habit_description"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/editHabitNameInputLayout"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- Edit habit Description input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/editHabitDescriptionInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="#D9D9D9"
                app:boxBackgroundMode="filled"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:hintEnabled="false"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:layout_constraintTop_toBottomOf="@id/editHabitDescriptionLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editHabitDescriptionInput"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="@string/what_does_this_habit_involve"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/black"
                    android:textColorHint="#777777"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Change Frequency label -->
            <TextView
                android:id="@+id/changeFrequencyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/frequency"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/editHabitDescriptionInputLayout"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Daily Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dailyCard"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="12dp"

                android:text="Daily&#10;Every day"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:gravity="start|center_vertical"
                android:paddingStart="14dp"

                app:backgroundTint="@color/avanza_light_grey"
                app:cornerRadius="12dp"
                app:strokeWidth="0dp"

                app:layout_constraintTop_toBottomOf="@id/changeFrequencyLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/weekDaysCard" />


            <!-- Weekdays Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/weekDaysCard"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="12dp"

                android:text="Weekdays&#10;Mon - Fri"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:gravity="start|center_vertical"
                android:paddingStart="14dp"

                app:backgroundTint="@color/avanza_light_grey"
                app:cornerRadius="12dp"
                app:strokeWidth="0dp"

                app:layout_constraintTop_toBottomOf="@id/changeFrequencyLabel"
                app:layout_constraintStart_toEndOf="@id/dailyCard"
                app:layout_constraintEnd_toEndOf="parent" />


            <!-- Weekends Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/weekendsCard"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="12dp"

                android:text="Weekends&#10;Sat - Sun"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:gravity="start|center_vertical"
                android:paddingStart="14dp"

                app:backgroundTint="@color/avanza_light_grey"
                app:cornerRadius="12dp"
                app:strokeWidth="0dp"

                app:layout_constraintTop_toBottomOf="@id/dailyCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/weeklyCard" />


            <!-- Weekly Button -->
            <com.google.android.material.button.MaterialButton
            android:id="@+id/weeklyCard"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="12dp"

            android:text="Weekly&#10;Once a week"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:gravity="start|center_vertical"
            android:paddingStart="14dp"

            app:backgroundTint="@color/avanza_light_grey"
            app:cornerRadius="12dp"
            app:strokeWidth="0dp"

            app:layout_constraintTop_toBottomOf="@id/weekDaysCard"
            app:layout_constraintStart_toEndOf="@id/weekendsCard"
            app:layout_constraintEnd_toEndOf="parent" />

            <!-- Cancel Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="20dp"

                android:text="Cancel"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"

                app:backgroundTint="@color/avanza_light_grey"
                app:cornerRadius="14dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnSave"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <!-- Save Habit button-->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="20dp"

                android:text="Save"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"

                app:backgroundTint="@color/avanza_blue"
                app:cornerRadius="14dp"
                app:layout_constraintStart_toEndOf="@id/btnCancel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>